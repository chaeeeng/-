    <script>
        // =========================================================================
        // 1. 전역 상태 변수
        // =========================================================================
        let currentTab = 3;
        let latestPsoHistory = [];
        let psoChartPoints = []; // 마우스/터치 툴팁용 좌표 캐시

        // =========================================================================
        // 2. 탭 전환 및 권역 선택 로직
        // =========================================================================
        function switchTab(tabIndex) {
            currentTab = tabIndex;
            for (let i = 1; i <= 3; i++) {
                const contentEl = document.getElementById(`tab-content-${i}`);
                const btnEl = document.getElementById(`tab-btn-${i}`);
