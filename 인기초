        }

        function selectRegion(region) {
            const regions = ['korea', 'japan', 'china'];
            regions.forEach(r => {
                const card = document.getElementById(`region-card-${r}`);
                if (!card) return;
                if (r === region) {
                    card.classList.remove('border', 'border-slate-200');
                    card.classList.add('border-2', r === 'korea' ? 'border-emerald-500' : (r === 'japan' ? 'border-sky-500' : 'border-amber-500'), 'shadow-sm');
                } else {
                    card.classList.remove('border-2', 'border-emerald-500', 'border-sky-500', 'border-amber-500', 'shadow-sm');
                    card.classList.add('border', 'border-slate-200');
                }
            });
        }

        // =========================================================================
        // 3. 고해상도(Retina/HiDPI) Canvas 준비 헬퍼
        // =========================================================================
        function setupHiDPICanvas(canvas, fallbackHeight) {
            const dpr = Math.max(window.devicePixelRatio || 1, 2);
            const rect = canvas.getBoundingClientRect();
            const cssWidth = rect.width > 0 ? rect.width : (canvas.parentElement ? canvas.parentElement.clientWidth : 600);
            const cssHeight = rect.height > 0 ? rect.height : fallbackHeight;

            canvas.width = Math.floor(cssWidth * dpr);
            canvas.height = Math.floor(cssHeight * dpr);

            const ctx = canvas.getContext('2d');
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            return { ctx, width: cssWidth, height: cssHeight };
        }

        // =========================================================================
        // 4. 온실 물리 반응 모델 & PSO 알고리즘 (30 Particles × 40 Iterations)
        // =========================================================================
        function calcVPD(tempC, rh) {
            const es = 0.61078 * Math.exp((17.27 * tempC) / (tempC + 237.3));
            const ea = es * (rh / 100.0);
            return Math.max(0.01, es - ea);
        }

        // 제어 변수(관수량 irr: 0~60 mL/주, 환기시간 vent: 0~60 분/시간) 적용 후 온실 상태 예측
        function predictGreenhouseState(inputs, irr, vent) {
            const ventRatio = vent / 60.0;
            const irrRatio = irr / 60.0;
            const isNightOrDawn = inputs.solar < 80;

            // 외기 추정 (새벽 vs 주간)
            let outTemp = isNightOrDawn ? inputs.temp - 1.8 : inputs.temp - 5.5;
            let outHumid = isNightOrDawn ? 72.0 : 52.0;

            // 환기(냉각·제습)와 관수(증산 냉각·가습) 반영
            const predTemp = inputs.temp + (outTemp - inputs.temp) * (0.45 * ventRatio) - (1.4 * irrRatio * (inputs.solar / 800));
            const humidDrop = (inputs.humid - outHumid) * (0.55 * ventRatio);
            const humidGain = 8.0 * irrRatio * (1 - 0.3 * ventRatio);
            const predHumid = Math.min(98, Math.max(35, inputs.humid - humidDrop + humidGain));

            // 근권 지습 변화 (일사 증산 소모 vs 점적 관수 보충)
            const evapLoss = 2.0 + (inputs.solar / 900) * 10.0;
            const soilGain = irrRatio * 24.0;
            const predSoil = Math.min(85, Math.max(15, inputs.soil - evapLoss + soilGain));

            const predVPD = calcVPD(predTemp, predHumid);
            return { predTemp, predHumid, predSoil, predVPD };
        }

        // 목적함수 (Loss): 농진청 VPD 기준 + 스마트팜코리아 시간대별 온도·습도 + 근권 지습 오차
        function computeLoss(inputs, irr, vent) {
            const isNightOrDawn = inputs.solar < 80;
            const targetVPD = isNightOrDawn ? 0.62 : 0.88;     // 농진청 적정 VPD (주간 개화기 0.85~0.90, 새벽 0.60 이상)
            const targetTemp = isNightOrDawn ? 12.5 : 24.5;    // 스마트팜코리아 야간 11~15°C / 주간 23~26°C
            const targetHumid = isNightOrDawn ? 82.0 : 65.0;   // 야간 90% 이하 / 주간 60~70%
            const targetSoil = 55.0;

            const pred = predictGreenhouseState(inputs, irr, vent);

            // 1) VPD 오차 (핵심 목적항)
            let vpdLoss = Math.abs(pred.predVPD - targetVPD) * 1.8;
            if (pred.predVPD < 0.50) {
                vpdLoss += Math.pow(0.50 - pred.predVPD, 2) * 12.0; // 결로 과습 페널티
            } else if (pred.predVPD > 1.20) {
                vpdLoss += Math.pow(pred.predVPD - 1.20, 2) * 10.0; // 고온 건조 페널티
            }

            // 2) 온도·습도·지습 오차
            const tempLoss = Math.abs(pred.predTemp - targetTemp) * 0.045;
            const humidLoss = Math.abs(pred.predHumid - targetHumid) * 0.015;
            const soilLoss = Math.abs(pred.predSoil - targetSoil) * 0.025;

            // 3) 자원 절약 규제항
            const energyPenalty = (irr / 60.0) * 0.03 + (vent / 60.0) * 0.03;

            return vpdLoss + tempLoss + humidLoss + soilLoss + energyPenalty;
        }

        // 결정론적 의사난수 (동일 슬라이더 조건에서도 자연스러운 입자 분포 보장)
        function seededRng(seed) {
            let s = Math.floor(Math.abs(seed) * 9973) % 2147483647;
            if (s <= 0) s += 2147483646;
            return function() {
                s = (s * 16807) % 2147483647;
                return (s - 1) / 2147483646;
            };
        }

        function executePSO(isManualClick = false) {
            const inputs = {
                temp: parseFloat(document.getElementById('input-temp').value),
                humid: parseFloat(document.getElementById('input-humid').value),
                solar: parseFloat(document.getElementById('input-solar').value),
                soil: parseFloat(document.getElementById('input-soil').value)
            };

            // 시간대 모드 배지 갱신
            const modeBadge = document.getElementById('mode-indicator');
            if (inputs.solar < 80) {
                modeBadge.textContent = '야간·새벽 과습방지 모드';
                modeBadge.className = 'text-[11px] font-bold px-2.5 py-1 rounded-full bg-sky-100 text-sky-800';
            } else {
                modeBadge.textContent = '주간 광합성·증산 제어 모드';
                modeBadge.className = 'text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800';
            }

            const numParticles = 30;
            const maxIter = 40;
            const irrMin = 5, irrMax = 60;
            const ventMin = 0, ventMax = 60;

            // 속도 제한(Vmax)을 설정해 40세대에 걸쳐 단계적으로 오차가 수렴하도록 구성
            const vIrrMax = (irrMax - irrMin) * 0.12;
            const vVentMax = (ventMax - ventMin) * 0.12;

            const seedVal = inputs.temp * 17.3 + inputs.humid * 5.1 + inputs.solar * 0.23 + inputs.soil * 3.7 + (isManualClick ? Math.random() * 50 : 7);
            const rand = seededRng(seedVal);

            let particles = [];
            let gBestIrr = 25;
            let gBestVent = 30;
            let gBestLoss = Infinity;

            // 입자 초기화
            for (let i = 0; i < numParticles; i++) {
                const irr = irrMin + rand() * (irrMax - irrMin);
                const vent = ventMin + rand() * (ventMax - ventMin);
                const vIrr = (rand() - 0.5) * vIrrMax;
                const vVent = (rand() - 0.5) * vVentMax;
                const loss = computeLoss(inputs, irr, vent);

                particles.push({
                    irr, vent, vIrr, vVent,
                    pBestIrr: irr, pBestVent: vent, pBestLoss: loss
                });

                if (loss < gBestLoss) {
                    gBestLoss = loss;
                    gBestIrr = irr;
                    gBestVent = vent;
                }
            }

            const history = [];

            // 40세대 탐색 루프
            for (let iter = 0; iter < maxIter; iter++) {
                const w = 0.90 - 0.50 * (iter / (maxIter - 1)); // 관성 가중치 감쇠
                const c1 = 1.60;
                const c2 = 1.65;

                for (let i = 0; i < numParticles; i++) {
                    const p = particles[i];
                    const r1 = rand();
                    const r2 = rand();

                    p.vIrr = w * p.vIrr + c1 * r1 * (p.pBestIrr - p.irr) + c2 * r2 * (gBestIrr - p.irr);
                    p.vVent = w * p.vVent + c1 * r1 * (p.pBestVent - p.vent) + c2 * r2 * (gBestVent - p.vent);

                    p.vIrr = Math.max(-vIrrMax, Math.min(vIrrMax, p.vIrr));
                    p.vVent = Math.max(-vVentMax, Math.min(vVentMax, p.vVent));

                    p.irr = Math.max(irrMin, Math.min(irrMax, p.irr + p.vIrr));
                    p.vent = Math.max(ventMin, Math.min(ventMax, p.vent + p.vVent));

                    const loss = computeLoss(inputs, p.irr, p.vent);
                    if (loss < p.pBestLoss) {
                        p.pBestLoss = loss;
                        p.pBestIrr = p.irr;
                        p.pBestVent = p.vent;
                    }
                    if (loss < gBestLoss) {
                        gBestLoss = loss;
                        gBestIrr = p.irr;
                        gBestVent = p.vent;
                    }
                }

                history.push(Number(gBestLoss.toFixed(4)));
            }

            latestPsoHistory = history;

            // UI 수치 업데이트
            const optIrr = Math.round(gBestIrr);
            const optVent = Math.round(gBestVent);
            const beforeVPD = calcVPD(inputs.temp, inputs.humid);
            const afterPred = predictGreenhouseState(inputs, optIrr, optVent);

            document.getElementById('res-irrigation').textContent = optIrr;
            document.getElementById('res-ventilation').textContent = optVent;
            document.getElementById('res-vpd-before').textContent = beforeVPD.toFixed(2);
            document.getElementById('res-vpd-after').textContent = afterPred.predVPD.toFixed(2);
            document.getElementById('final-loss-text').textContent = history[history.length - 1].toFixed(4);

            const statusEl = document.getElementById('res-vpd-status');
            if (afterPred.predVPD >= 0.80 && afterPred.predVPD <= 1.05) {
                statusEl.textContent = '토마토 최적 구간(0.8~1.0) 도달';
                statusEl.className = 'text-[11px] font-bold text-indigo-700';
            } else if (afterPred.predVPD >= 0.50 && afterPred.predVPD <= 1.20) {
                statusEl.textContent = `농진청 적정 구간(0.5~1.2) 안정 진입`;
                statusEl.className = 'text-[11px] font-bold text-emerald-700';
            } else {
                statusEl.textContent = `극한 기후 보정 (${afterPred.predTemp.toFixed(1)}°C / ${Math.round(afterPred.predHumid)}%)`;
                statusEl.className = 'text-[11px] font-bold text-amber-700';
            }

            // 수렴 곡선 즉시 그리기
            drawPsoConvergenceChart(history);
        }

        // =========================================================================
        // 5. 순수 HTML5 Canvas 차트 1: PSO 목적함수 수렴 곡선 (100% 오프라인·모바일 보장)
        // =========================================================================
        function drawPsoConvergenceChart(data) {
            const canvas = document.getElementById('psoCanvas');
            if (!canvas || !data || data.length === 0) return;

            const { ctx, width, height } = setupHiDPICanvas(canvas, 235);
            ctx.clearRect(0, 0, width, height);

            const pad = { top: 20, right: 20, bottom: 32, left: 52 };
            const plotW = width - pad.left - pad.right;
            const plotH = height - pad.top - pad.bottom;

            const rawMin = Math.min(...data);
            const rawMax = Math.max(...data);
            const spread = Math.max(0.015, rawMax - rawMin);
            const yMin = Math.max(0, rawMin - spread * 0.15);
            const yMax = rawMax + spread * 0.15;
            const yRange = Math.max(0.001, yMax - yMin);

            // 배경 그리드 및 Y축 눈금 (5단계)
            ctx.font = '600 11px Inter, sans-serif';
            ctx.textAlign = 'right';
            ctx.textBaseline = 'middle';

            const ySteps = 4;
            for (let i = 0; i <= ySteps; i++) {
                const ratio = i / ySteps;
                const val = yMax - ratio * yRange;
                const y = pad.top + ratio * plotH;

                ctx.strokeStyle = '#e2e8f0';
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.moveTo(pad.left, y);
                ctx.lineTo(pad.left + plotW, y);
                ctx.stroke();

                ctx.fillStyle = '#64748b';
                ctx.fillText(val.toFixed(3), pad.left - 8, y);
            }

            // X축 눈금 (1세대, 6세대, 11세대 ... 36세대, 40세대)
            ctx.textAlign = 'center';
            ctx.textBaseline = 'top';
            const xLabels = [0, 4, 9, 14, 19, 24, 29, 34, 39];
            xLabels.forEach(idx => {
                if (idx >= data.length) return;
                const x = pad.left + (idx / (data.length - 1)) * plotW;
                ctx.fillStyle = '#64748b';
                ctx.fillText(`${idx + 1}세대`, x, pad.top + plotH + 9);
            });

            // 좌표 계산
            psoChartPoints = data.map((val, idx) => {
                const x = pad.left + (idx / (data.length - 1)) * plotW;
                const y = pad.top + ((yMax - val) / yRange) * plotH;
                return { x, y, gen: idx + 1, loss: val };
            });

            // 면적 그라데이션 채우기
            const grad = ctx.createLinearGradient(0, pad.top, 0, pad.top + plotH);
            grad.addColorStop(0, 'rgba(5, 150, 105, 0.24)');
            grad.addColorStop(1, 'rgba(5, 150, 105, 0.02)');

            ctx.beginPath();
            ctx.moveTo(psoChartPoints[0].x, pad.top + plotH);
            psoChartPoints.forEach(pt => ctx.lineTo(pt.x, pt.y));
            ctx.lineTo(psoChartPoints[psoChartPoints.length - 1].x, pad.top + plotH);
            ctx.closePath();
            ctx.fillStyle = grad;
            ctx.fill();

            // 에메랄드 그린 수렴 곡선 선 그리기
            ctx.beginPath();
            ctx.strokeStyle = '#059669';
            ctx.lineWidth = 2.6;
            ctx.lineJoin = 'round';
            psoChartPoints.forEach((pt, i) => {
                if (i === 0) ctx.moveTo(pt.x, pt.y);
                else ctx.lineTo(pt.x, pt.y);
            });
            ctx.stroke();

            // 각 세대 포인트 마커
            psoChartPoints.forEach((pt, idx) => {
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, idx === psoChartPoints.length - 1 ? 4.5 : 2.6, 0, Math.PI * 2);
                ctx.fillStyle = idx === psoChartPoints.length - 1 ? '#047857' : '#10b981';
                ctx.fill();
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 1.2;
                ctx.stroke();
            });
        }

        // PSO 차트 마우스/터치 툴팁 인터랙션
        function bindPsoTooltip() {
            const container = document.getElementById('pso-canvas-container');
            const tooltip = document.getElementById('pso-tooltip');
            if (!container || !tooltip) return;

            const handleMove = (clientX) => {
                if (!psoChartPoints.length) return;
                const rect = container.getBoundingClientRect();
                const relX = clientX - rect.left;

                let closest = psoChartPoints[0];
                let minDist = Infinity;
                psoChartPoints.forEach(pt => {
                    const d = Math.abs(pt.x - relX);
                    if (d < minDist) {
                        minDist = d;
                        closest = pt;
                    }
                });

                tooltip.textContent = `${closest.gen}세대 · 손실 오차: ${closest.loss.toFixed(4)}`;
                tooltip.classList.remove('hidden');
                const leftPos = Math.min(rect.width - 155, Math.max(8, closest.x - 65));
                const topPos = Math.max(8, closest.y - 34);
                tooltip.style.left = `${leftPos}px`;
                tooltip.style.top = `${topPos}px`;
            };

            container.addEventListener('mousemove', e => handleMove(e.clientX));
            container.addEventListener('touchstart', e => {
                if (e.touches[0]) handleMove(e.touches[0].clientX);
            }, { passive: true });
            container.addEventListener('mouseleave', () => tooltip.classList.add('hidden'));
        }

        // =========================================================================
        // 6. 순수 HTML5 Canvas 차트 2 & 3 (탭 2 한국 Cfa 실측 시각화)
        // =========================================================================
        function drawDiurnalChart() {
            const canvas = document.getElementById('diurnalCanvas');
            if (!canvas) return;
            const { ctx, width, height } = setupHiDPICanvas(canvas, 270);
            ctx.clearRect(0, 0, width, height);

            const avgTemp = [13.5, 13.3, 13.1, 13.0, 13.2, 13.4, 14.2, 16.5, 19.8, 22.6, 24.8, 26.5, 27.8, 28.2, 27.6, 26.1, 23.8, 20.5, 18.1, 16.6, 15.5, 14.8, 14.2, 13.8];
            const avgHumid = [94.5, 95.2, 95.5, 95.8, 95.3, 94.6, 91.8, 84.5, 75.2, 68.4, 63.5, 60.2, 58.5, 57.8, 59.4, 62.8, 68.5, 76.4, 83.2, 87.5, 90.2, 91.8, 93.1, 93.9];
            const avgVPD = [0.08, 0.07, 0.07, 0.06, 0.07, 0.08, 0.13, 0.29, 0.57, 0.86, 1.14, 1.38, 1.55, 1.61, 1.50, 1.26, 0.93, 0.57, 0.35, 0.24, 0.17, 0.14, 0.11, 0.09];

            const pad = { top: 34, right: 44, bottom: 28, left: 42 };
            const plotW = width - pad.left - pad.right;
            const plotH = height - pad.top - pad.bottom;

            // 범례 상단
            ctx.font = '700 11px Noto Sans KR, sans-serif';
            ctx.textAlign = 'left';
            ctx.fillStyle = '#0284c7'; ctx.fillRect(pad.left, 10, 10, 10);
            ctx.fillStyle = '#334155'; ctx.fillText('내부습도(%)', pad.left + 14, 19);

            ctx.fillStyle = '#e11d48'; ctx.fillRect(pad.left + 95, 10, 10, 10);
            ctx.fillStyle = '#334155'; ctx.fillText('내부온도(°C)', pad.left + 109, 19);

            ctx.fillStyle = '#059669'; ctx.fillRect(pad.left + 195, 10, 10, 10);
            ctx.fillStyle = '#334155'; ctx.fillText('내부VPD(kPa)', pad.left + 209, 19);

            // 그리드 & 좌·우 Y축
            ctx.font = '500 10px Inter, sans-serif';
            for (let i = 0; i <= 4; i++) {
                const y = pad.top + (i / 4) * plotH;
                ctx.strokeStyle = '#e2e8f0';
                ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + plotW, y); ctx.stroke();

                ctx.textAlign = 'right';
                ctx.fillStyle = '#64748b';
                ctx.fillText(`${100 - i * 25}`, pad.left - 6, y + 3);

                ctx.textAlign = 'left';
                ctx.fillStyle = '#059669';
                ctx.fillText(`${(2.0 - i * 0.5).toFixed(1)}`, pad.left + plotW + 6, y + 3);
            }

            // X축 시간 라벨
            ctx.textAlign = 'center';
            ctx.fillStyle = '#64748b';
            [0, 4, 8, 12, 16, 20, 23].forEach(h => {
                const x = pad.left + (h / 23) * plotW;
                ctx.fillText(`${String(h).padStart(2, '0')}시`, x, pad.top + plotH + 15);
            });

            const drawSeries = (arr, maxVal, color, lineW) => {
                ctx.beginPath();
                ctx.strokeStyle = color;
                ctx.lineWidth = lineW;
                arr.forEach((v, idx) => {
                    const x = pad.left + (idx / 23) * plotW;
                    const y = pad.top + ((maxVal - v) / maxVal) * plotH;
                    if (idx === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                });
                ctx.stroke();
            };

            drawSeries(avgHumid, 100, '#0284c7', 2);
            drawSeries(avgTemp, 100, '#e11d48', 2);
            drawSeries(avgVPD, 2.0, '#059669', 2.8);
        }

        function drawVpdDistChart() {
            const canvas = document.getElementById('vpdDistCanvas');
            if (!canvas) return;
            const { ctx, width, height } = setupHiDPICanvas(canvas, 270);
            ctx.clearRect(0, 0, width, height);

            const bars = [
                { label: '극심과습\n(<0.3)', pct: 31.4, color: '#0284c7' },
                { label: '주의과습\n(0.3~0.5)', pct: 15.4, color: '#38bdf8' },
                { label: '적정하단\n(0.5~0.8)', pct: 15.7, color: '#10b981' },
                { label: '개화최적\n(0.8~1.0)', pct: 12.7, color: '#059669' },
                { label: '적정상단\n(1.0~1.2)', pct: 10.0, color: '#34d399' },
                { label: '고온건조\n(>1.2)', pct: 14.8, color: '#f43f5e' }
            ];

            const pad = { top: 24, right: 16, bottom: 38, left: 38 };
            const plotW = width - pad.left - pad.right;
            const plotH = height - pad.top - pad.bottom;
            const maxPct = 35;

            ctx.font = '500 10px Inter, sans-serif';
            ctx.textAlign = 'right';
            for (let i = 0; i <= 5; i++) {
                const val = maxPct - i * 7;
                const y = pad.top + (i / 5) * plotH;
                ctx.strokeStyle = '#e2e8f0';
                ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + plotW, y); ctx.stroke();
                ctx.fillStyle = '#64748b';
                ctx.fillText(`${val}%`, pad.left - 6, y + 3);
            }

            const slotW = plotW / bars.length;
            const barW = Math.min(38, slotW * 0.62);

            bars.forEach((b, idx) => {
                const cx = pad.left + slotW * idx + slotW / 2;
                const barH = (b.pct / maxPct) * plotH;
                const y = pad.top + plotH - barH;

                ctx.fillStyle = b.color;
                ctx.beginPath();
                ctx.roundRect(cx - barW / 2, y, barW, barH, [6, 6, 0, 0]);
                ctx.fill();

                ctx.fillStyle = '#1e293b';
                ctx.font = '700 10.5px Inter, sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(`${b.pct}%`, cx, y - 6);

                const lines = b.label.split('\n');
                ctx.fillStyle = '#475569';
                ctx.font = '600 9.5px Noto Sans KR, sans-serif';
                ctx.fillText(lines[0], cx, pad.top + plotH + 13);
                ctx.fillText(lines[1], cx, pad.top + plotH + 25);
            });
        }

        // =========================================================================
        // 7. 슬라이더 & 프리셋 핸들러 + 초기화 보장
        // =========================================================================
        function onSliderChange() {
            const temp = parseFloat(document.getElementById('input-temp').value);
            const humid = parseInt(document.getElementById('input-humid').value, 10);
            const solar = parseInt(document.getElementById('input-solar').value, 10);
            const soil = parseInt(document.getElementById('input-soil').value, 10);

            document.getElementById('val-temp').textContent = `${temp.toFixed(1)} °C`;
            document.getElementById('val-humid').textContent = `${humid} %`;
            document.getElementById('val-solar').textContent = `${solar} W/m²`;
            document.getElementById('val-soil').textContent = `${soil} %`;

            executePSO(false);
        }

        function applyPreset(type) {
            if (type === 'dawn') {
                document.getElementById('input-temp').value = 13.5;
                document.getElementById('input-humid').value = 95;
                document.getElementById('input-solar').value = 15;
                document.getElementById('input-soil').value = 48;
            } else if (type === 'noon') {
                document.getElementById('input-temp').value = 34.5;
                document.getElementById('input-humid').value = 52;
                document.getElementById('input-solar').value = 780;
                document.getElementById('input-soil').value = 24;
            }
            onSliderChange();
        }

        function initApp() {
            bindPsoTooltip();
            onSliderChange();
        }

        window.addEventListener('DOMContentLoaded', initApp);
        window.addEventListener('load', () => {
            if (!latestPsoHistory.length) initApp();
            else drawPsoConvergenceChart(latestPsoHistory);
        });
        window.addEventListener('resize', () => {
            if (currentTab === 2) {
                drawDiurnalChart();
                drawVpdDistChart();
            } else if (currentTab === 3) {
                drawPsoConvergenceChart(latestPsoHistory);
            }
        });
    </script>
